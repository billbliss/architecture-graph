{
  "name": "@billbliss/architecture-graph",
  "version": "0.4.1",
  "description": "Portable architectural declarations, context, and derived guidance",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ag": "bin/ag.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "import": "./lib/core.js"
    },
    "./schema": "./schema/graph.schema.json"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "skills",
    "docs",
    "README.md",
    "examples/hello-world/*.md",
    "examples/hello-world/package.json",
    "examples/hello-world/ag.config.json",
    "examples/hello-world/app.test.js",
    "examples/hello-world/src",
    "examples/hello-world/architecture",
    "examples/hello-world/stages",
    "lib",
    "tsconfig.json"
  ],
  "workspaces": [
    "packages/audit"
  ],
  "scripts": {
    "test": "npm run build && node --test test/*.test.js && node --test packages/audit/test/*.test.js",
    "test:consumer": "node test/consumer.mjs",
    "verify": "npm test && npm run test:consumer",
    "package": "node scripts/package.mjs",
    "test:package": "node scripts/test-package.mjs",
    "build": "tsc -p tsconfig.json && node scripts/schema.mjs && npm run build --workspace packages/audit",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/billbliss/architecture-graph.git"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild": false
  },
  "types": "./lib/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
