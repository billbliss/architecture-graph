{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "checkVersion": {
      "type": "string",
      "const": "1"
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^check:[a-z0-9][a-z0-9._-]*$"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "tripwire",
                  "audited"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "kind": {
                "type": "string",
                "const": "forbidden_dependency"
              },
              "from": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "to": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "id",
              "mode",
              "description",
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^check:[a-z0-9][a-z0-9._-]*$"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "tripwire",
                  "audited"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "kind": {
                "type": "string",
                "const": "forbidden_reachability"
              },
              "entries": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "forbidden": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "forbiddenPackages": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "id",
              "mode",
              "description",
              "kind",
              "entries"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "checkVersion",
    "checks"
  ],
  "additionalProperties": false
}
