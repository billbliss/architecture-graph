{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reportVersion": {
      "type": "string",
      "const": "1"
    },
    "limitation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "protocol": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "version",
        "protocol"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^check:[a-z0-9][a-z0-9._-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "forbidden_dependency",
              "forbidden_reachability"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "tripwire",
              "audited"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "guardrails": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "mode",
          "file",
          "guardrails"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "forbidden_dependency",
              "forbidden_reachability",
              "unresolved_import"
            ]
          },
          "check": {
            "type": "string",
            "pattern": "^check:[a-z0-9][a-z0-9._-]*$"
          },
          "classification": {
            "type": "string",
            "enum": [
              "new",
              "baselined",
              "resolved"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "specifier": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "kind",
          "check",
          "classification",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "baselineGrowth": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "filesParsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "externalTerminals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolvedImports": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "filesParsed",
        "externalTerminals",
        "unresolvedImports"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "new": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselineGrowth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 3
            }
          ]
        }
      },
      "required": [
        "new",
        "baselined",
        "resolved",
        "baselineGrowth",
        "exitCode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "reportVersion",
    "limitation",
    "tool",
    "checks",
    "findings",
    "baselineGrowth",
    "coverage",
    "summary"
  ],
  "additionalProperties": false
}
