{
  "auditVersion": "1",
  "baseline": "architecture/audit-baseline.yaml",
  "typescript": [
    {
      "paths": [
        "src/**"
      ],
      "tsconfig": "tsconfig.json"
    }
  ],
  "modules": {
    "module:routes": [
      "src/routes/**"
    ],
    "module:export": [
      "src/export/**"
    ],
    "module:legacy": [
      "src/legacy/**"
    ]
  }
}
