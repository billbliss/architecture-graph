---
// The task service, the Task changed contract and its consumers, read from the task-manager example's
// graph and contract sidecars at build time. Nothing here is hand-copied.
import { contractView } from '../lib/graph';
import { highlight } from '../lib/highlight';
import { githubUrl } from '../lib/repo';

const view = contractView('task-manager', 'contract:task-changed');
const exampleHtml = await highlight(view.example, 'json');
const uid = 'contract-graphic';
---

<figure class="graphic" aria-labelledby={`${uid}-caption`}>
  <div class="flow">
    <div class="provider">
      <div class={`node kind kind-${view.provider.node.kind} status-${view.provider.node.status}`}>
        <span class="kind-label">{view.provider.node.kind}</span>
        <strong>{view.provider.node.name}</strong>
        <span class="role">authority for the contract</span>
      </div>
    </div>

    <div class={`contract kind kind-${view.node.kind} status-${view.node.status}`}>
      <header>
        <span class="kind-label">{view.node.kind}</span>
        <h3>{view.node.name}</h3>
        <p>{view.node.description}</p>
      </header>
      <div class="tabs" role="tablist" aria-label="Contract details">
        <button role="tab" id={`${uid}-tab-structure`} aria-controls={`${uid}-structure`} aria-selected="true">Structure</button>
        <button role="tab" id={`${uid}-tab-example`} aria-controls={`${uid}-example`} aria-selected="false" tabindex="-1">Example</button>
      </div>
      <div class="panel" role="tabpanel" id={`${uid}-structure`} aria-labelledby={`${uid}-tab-structure`}>
        <table>
          <caption class="visually-hidden">Fields of {view.schemaTitle}</caption>
          <tbody>
            {view.fields.map(field => (
              <tr>
                <th scope="row"><code>{field.name}</code>{field.required ? null : <span class="optional">optional</span>}</th>
                <td><span class="type">{field.type}</span>{field.description && <span class="desc">{field.description}</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="source"><a href={githubUrl(view.schemaPath)}>{view.schemaPath.split('/').slice(-2).join('/')}</a></p>
      </div>
      <div class="panel" role="tabpanel" id={`${uid}-example`} aria-labelledby={`${uid}-tab-example`} hidden>
        <Fragment set:html={exampleHtml} />
        <p class="source"><a href={githubUrl(view.examplePath)}>{view.examplePath.split('/').slice(-3).join('/')}</a></p>
      </div>
    </div>

    <ul class="consumers" aria-label="Consumers">
      {view.consumers.map((consumer, index) => (
        <li>
          <div class={`node kind kind-${consumer.node.kind} status-${consumer.node.status}`} tabindex="0" aria-describedby={`${uid}-consumer-${index}`}>
            <span class="kind-label">consumes</span>
            <strong>{consumer.node.name}</strong>
            <span class="tip" role="tooltip" id={`${uid}-consumer-${index}`}>{consumer.description}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <figcaption id={`${uid}-caption`} class="muted">
    One contract, {view.consumers.length} consumers, from the <a href="/examples/task-manager/">task-manager example</a>. The structure and example come from the contract's schema and example files, which <code>ag validate</code> checks against each other starting with the next release. Hover or focus a consumer to see why it depends on the contract.
  </figcaption>
</figure>

<script>
  for (const list of document.querySelectorAll<HTMLElement>('.graphic [role="tablist"]')) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute('aria-selected', String(selected));
        other.tabIndex = selected ? 0 : -1;
        document.getElementById(other.getAttribute('aria-controls')!)!.hidden = !selected;
      }
      tab.focus();
    };
    list.addEventListener('click', event => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab);
    });
    list.addEventListener('keydown', event => {
      const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (index < 0) return;
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        select(tabs[(index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]);
      }
    });
  }
</script>

<style>
  .graphic { margin: 0; }
  .flow { display: grid; grid-template-columns: minmax(9rem, 0.7fr) minmax(0, 2.2fr) minmax(10rem, 0.9fr); gap: 2rem; align-items: center; }
  .node { position: relative; display: flex; flex-direction: column; gap: 0.1rem; padding: 0.7rem 0.85rem; border-radius: 8px; background: var(--bg-raised); border: 1px dashed color-mix(in srgb, var(--kind) 70%, transparent); border-left: 3px solid var(--kind); }
  .node strong { font-size: 0.98rem; }
  .role { font-size: 0.8rem; color: var(--text-muted); }

  /* Status: proposed outlines are dashed, implemented solid, unresolved in the warning color. */
  .status-implemented { border-style: solid !important; }
  .status-unresolved { border-color: var(--status-unresolved) !important; }

  /* Connectors: provider → contract → each consumer. */
  .provider .node::after { content: ''; position: absolute; left: 100%; top: 50%; width: 2rem; border-top: 2px dashed var(--border-strong); }
  .consumers { list-style: none; margin: 0; padding: 0 0 0 0; display: grid; gap: 0.8rem; position: relative; }
  .consumers::before { content: ''; position: absolute; left: -1rem; top: 1.6rem; bottom: 1.6rem; border-left: 2px dashed var(--border-strong); }
  .consumers .node::before { content: ''; position: absolute; right: 100%; top: 50%; width: 1rem; border-top: 2px dashed var(--border-strong); }
  .consumers .node { cursor: help; }
  .consumers .node:hover, .consumers .node:focus-visible { background: var(--bg-sunken); }

  .tip { position: absolute; z-index: 3; right: 0; top: calc(100% + 0.4rem); width: max(16rem, 100%); padding: 0.55rem 0.7rem; border-radius: 8px; background: var(--bg-sunken); border: 1px solid var(--border-strong); color: var(--text); font-size: 0.85rem; line-height: 1.45; box-shadow: 0 8px 24px rgb(0 0 0 / 0.35); opacity: 0; visibility: hidden; transition: opacity 0.12s; }
  .node:hover .tip, .node:focus .tip { opacity: 1; visibility: visible; }

  .contract { position: relative; border-radius: var(--radius); background: var(--bg-raised); border: 1px dashed color-mix(in srgb, var(--kind) 70%, transparent); border-top: 3px solid var(--kind); padding: 1rem 1.1rem 0.6rem; min-width: 0; }
  .contract h3 { margin: 0.1rem 0 0.3rem; font-size: 1.2rem; }
  .contract header p { margin: 0 0 0.8rem; font-size: 0.92rem; color: var(--text-muted); }

  .tabs { display: flex; gap: 0.25rem; border-bottom: 1px solid var(--border); margin-bottom: 0.6rem; }
  .tabs button { background: none; border: 0; border-bottom: 2px solid transparent; color: var(--text-muted); padding: 0.35rem 0.6rem; font: inherit; font-size: 0.88rem; cursor: pointer; margin-bottom: -1px; }
  .tabs button[aria-selected='true'] { color: var(--text); border-bottom-color: var(--kind); }

  .panel table { display: table; font-size: 0.84rem; }
  .panel th, .panel td { border: 0; border-bottom: 1px solid var(--border); background: none; padding: 0.32rem 0.4rem; }
  .panel th { white-space: nowrap; font-weight: normal; }
  .optional { margin-left: 0.4rem; font-size: 0.72rem; color: var(--text-muted); }
  .type { font-family: var(--font-mono); font-size: 0.8rem; color: var(--kind); margin-right: 0.5rem; }
  .desc { color: var(--text-muted); }
  .panel :global(pre) { font-size: 0.78rem; margin: 0; max-height: 20.5rem; }
  .source { font-size: 0.78rem; margin: 0.4rem 0 0; text-align: right; }
  figcaption { font-size: 0.85rem; margin-top: 1.2rem; }

  @media (max-width: 60rem) {
    .flow { grid-template-columns: 1fr; gap: 1.2rem; }
    .provider .node::after, .consumers::before, .consumers .node::before { display: none; }
    .consumers { grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); }
    .tip { left: 0; right: auto; }
  }
</style>
