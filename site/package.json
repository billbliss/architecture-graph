{
  "name": "architecturegraph-dev",
  "private": true,
  "type": "module",
  "description": "architecturegraph.dev: the Architecture Graph website",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "toolkit": "npm --prefix .. ci && npm --prefix .. run build",
    "dev": "astro dev",
    "build": "astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "pages:build": "npm run toolkit && npm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@billbliss/architecture-graph": "file:..",
    "@shikijs/rehype": "^4.6.0",
    "@types/hast": "^3.0.5",
    "astro": "^7.4.5",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
