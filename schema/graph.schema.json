{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Graph graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "nodes",
    "relationships"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "description",
          "status",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "actor",
              "component",
              "capability",
              "contract",
              "artifact",
              "transform",
              "surface",
              "policy",
              "boundary",
              "decision"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "proposed",
              "implemented",
              "unresolved"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "design",
                    "implementation"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "from",
          "to",
          "description",
          "status",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "owns",
              "provides",
              "depends_on",
              "consumes",
              "produces",
              "preserves",
              "governed_by",
              "authority_for",
              "constrained_by",
              "affects"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "proposed",
              "implemented",
              "unresolved"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "design",
                    "implementation"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  }
}
