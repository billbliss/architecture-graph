{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "configVersion": {
      "type": "string",
      "const": "1"
    },
    "graph": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "generated": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "configVersion",
    "graph",
    "generated"
  ],
  "additionalProperties": false
}
