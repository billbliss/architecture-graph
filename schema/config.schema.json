{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Graph config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "graph",
    "generated"
  ],
  "properties": {
    "configVersion": {
      "const": "1"
    },
    "graph": {
      "type": "string",
      "minLength": 1
    },
    "generated": {
      "type": "string",
      "minLength": 1
    }
  }
}
